# Keep the .gitignore exclusions when preparing an EAS Build archive.
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env*.local
*.tsbuildinfo
/tmp/
/coverage/
/ios
/android

# Local and source-only material is not needed to compile the APK.
/.git/
/.claude/
/.eas-archive-inspect/
/Documentation/
/__tests__/
/scripts/
/assets/icons-modern/
/AGENTS.md
/.env
/.env.*
